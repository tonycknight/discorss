ARG BuildVersion

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 63530

# Creates a non-root user with an explicit UID and adds permission to access the /app folder
# For more info, please refer to https://aka.ms/vscode-docker-dotnet-configure-containers
RUN adduser -u 5678 --disabled-password --gecos "" discorssuser && chown -R discorssuser /app
USER discorssuser

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BuildVersion
WORKDIR /src

COPY ["src/Discorss.Feeds.Service/Discorss.Feeds.Service.fsproj", "src/Discorss.Feeds.Service/"]
RUN dotnet restore "src/Discorss.Feeds.Service/Discorss.Feeds.Service.fsproj"
COPY . .
WORKDIR "/src/src/Discorss.Feeds.Service"
RUN dotnet tool restore
RUN dotnet paket restore
RUN dotnet build "Discorss.Feeds.Service.fsproj" -c Release -o /app/build /p:AssemblyInformationalVersion=${BuildVersion} /p:AssemblyFileVersion=${BuildVersion}

FROM build AS publish
ARG BuildVersion
RUN dotnet publish "Discorss.Feeds.Service.fsproj" -c Release -o /app/publish /p:UseAppHost=false /p:AssemblyInformationalVersion=${BuildVersion} /p:AssemblyFileVersion=${BuildVersion} /p:Version=${BuildVersion}

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Discorss.Feeds.Service.dll", ""]
