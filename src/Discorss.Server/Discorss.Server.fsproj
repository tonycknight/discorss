<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Models.fs" />
    <Compile Include="WebAppHandlers.fs" />
    <Compile Include="WebApp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Giraffe" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Discorss.Common\Discorss.Common.fsproj" />
    <ProjectReference Include="..\Discorss.Documents.Service\Discorss.Documents.Service.fsproj" />
    <ProjectReference Include="..\Discorss.Feeds.Service\Discorss.Feeds.Service.fsproj" />
    <ProjectReference Include="..\Discorss.Ingestion\Discorss.Ingestion.fsproj" />
  </ItemGroup>
</Project>
