<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Copyright>Copyright 2026 Tony Knight</Copyright>
    <Authors>Tony Knight</Authors>
    <Description>CLI for Discorss</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>discorss</ToolCommandName>
    <PackageId>discorss-cli</PackageId>
    <RepositoryUrl>https://github.com/tonycknight/discorss</RepositoryUrl>
    <PackageProjectUrl>https://github.com/tonycknight/discorss</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="False" />
    <Compile Include="Utils.fs" />
    <Compile Include="Console.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="DiscorssApi.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Feeds.fs" />
    <Compile Include="Documents.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Discorss.ApiModels\Discorss.ApiModels.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="Tk.Nuget" Version="0.2.219" />
  </ItemGroup>

</Project>
